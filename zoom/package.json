{
  "name": "genasl-zoom-app",
  "version": "1.0.0",
  "description": "GenASL Zoom Integration - AI-powered Sign Language Translation for Zoom Meetings",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "test": "jest",
    "test:watch": "jest --watch",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "zoom",
    "sign-language",
    "asl",
    "accessibility",
    "ai",
    "translation",
    "meetings"
  ],
  "author": "GenASL Team",
  "license": "MIT",
  "dependencies": {
    "@zoom/meetingsdk": "^3.8.10",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.26.2",
    "axios": "^1.7.7",
    "socket.io-client": "^4.7.5",
    "styled-components": "^6.1.13",
    "@emotion/react": "^11.13.3",
    "@emotion/styled": "^11.13.0",
    "@mui/material": "^6.1.2",
    "@mui/icons-material": "^6.1.2",
    "react-uuid": "^2.0.0",
    "lodash": "^4.17.21",
    "date-fns": "^3.6.0",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
